{
  "expo": {
    "name": "BiteLog",
    "slug": "bitelog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bitelog-icon.png",
    "scheme": "bitelog",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#006E2F",
        "foregroundImage": "./assets/images/bitelog-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#006E2F",
          "image": "./assets/images/bitelog-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
