PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d
DATABASE_PATH=./data/calorie-tracker.db

# Which food-search provider /foods/search uses: usda (free) or edamam (paid).
FOOD_PROVIDER=usda

# Optional: free (https://fdc.nal.usda.gov/api-key-signup). Without this,
# USDA search still works via the public DEMO_KEY, just at a much lower rate
# limit (30 req/hour vs 1000 req/hour with your own free key).
USDA_API_KEY=

# Optional: only used when FOOD_PROVIDER=edamam (https://developer.edamam.com).
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
