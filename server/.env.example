PORT=4000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=30d
DATABASE_PATH=./data/calorie-tracker.db

# Optional: Edamam Food Database API credentials (https://developer.edamam.com).
# Without these, /foods/search still works but only returns local (curated/
# custom/previously-imported) results - no external provider search.
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
